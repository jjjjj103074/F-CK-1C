{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:f-ck-1c:reference-library:knowledge:1",
  "title": "Reference library topic and knowledge contracts",
  "description": "The root validates topic front matter; $defs/entry validates each entry's YAML block. Load the source schema in the local registry before resolving references.",
  "$comment": "Markdown headings/bodies, evidence existence, canonical topic membership, physical file placement, and rights consistency require cross-file checks. Entry IDs live only in level-two KNO headings.",
  "oneOf": [{"$ref": "#/$defs/topic"}, {"$ref": "#/$defs/topic_supplement"}],
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "topic_id", "title", "scope", "related_topics", "updated_at"],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "topic"},
        "topic_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/topic_id"},
        "title": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/text"},
        "scope": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/text"},
        "related_topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/topic_id"}
        },
        "updated_at": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/date"}
      }
    },
    "topic_supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "topic_id", "updated_at"],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "topic_supplement"},
        "topic_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/topic_id"},
        "updated_at": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/date"}
      },
      "description": "Local-only supplement of an existing canonical topic. It cannot redefine title, scope, or topic relationships."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version_id", "relation_id"],
      "properties": {
        "source_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/source_id"},
        "version_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/version_id"},
        "relation_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/relation_id"},
        "asset_id": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/asset_id"},
        "locator": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/locator"}
      },
      "description": "Resolve grades and conditions from the scoped source relation; do not duplicate them here. A narrower locator must remain inside that relationship's actual scope."
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "review", "publication", "evidence"],
      "properties": {
        "kind": {"enum": ["finding", "explanation", "equation", "data", "method", "procedure", "observation", "limitation"]},
        "review": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/review"},
        "publication": {"$ref": "urn:f-ck-1c:reference-library:source:1#/$defs/publication"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "description": "Metadata for one nonempty source-grounded Markdown entry. The stable KNO ID belongs in its heading, not this object."
    }
  }
}
