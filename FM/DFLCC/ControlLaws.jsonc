{
  "direct_mapping": {
    // 三軸輸入與曲線輸出皆為 [-1, 1] 無因次數值。
    // 每個節點為 [輸入, 輸出]；輸入必須嚴格遞增，包含 [-1, ...]、[0, 0]、[1, ...]。
    // 先對曲線線性插值，再乘上 gain，最後限制舵面位置需求至 [-1, 1]。
    // gain 為有限非負數值；曲線輸出與輸入維持相同操縱方向。
    "pitch": {
      // 拉桿為正，對應對稱平尾的抬頭方向。
      "gain": 1.0,
      "curve": [[-1.0, -1.0], [0.0, 0.0], [1.0, 1.0]]
    },
    "roll": {
      // 右桿為正，對應差動襟副翼的右滾方向。
      "gain": 1.0,
      "curve": [[-1.0, -1.0], [0.0, 0.0], [1.0, 1.0]]
    },
    "yaw": {
      // 左腳舵為正，對應方向舵的左偏航方向。
      "gain": 1.0,
      "curve": [[-1.0, -1.0], [0.0, 0.0], [1.0, 1.0]]
    }
  }
}
