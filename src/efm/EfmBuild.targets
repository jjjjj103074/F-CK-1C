<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <AdditionalOptions>/external:I"$(EfmRepoRoot)\src\efm\F-CK-1C_EFM\ThirdParty" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(RunCodeAnalysis)' == 'true' Or '$(RunCodeAnalysisOnce)' == 'true'">
    <ClCompile>
      <EnablePREfast>true</EnablePREfast>
      <PREfastAdditionalPlugins>$(VCToolsInstallDir)bin\Hostx64\x64\EspXEngine.dll;%(PREfastAdditionalPlugins)</PREfastAdditionalPlugins>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ConfigureEfmAnalysis" BeforeTargets="ClCompile"
          Condition="'$(RunCodeAnalysis)' == 'true' Or '$(RunCodeAnalysisOnce)' == 'true'">
    <SetEnv Name="Esp.Extensions" Value="CppCoreCheck.dll" Prefix="false" />
  </Target>
  <Target Name="ValidateEfmBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)|$(Platform)' != 'Release|x64'"
           Text="請使用 Release|x64 建置 EFM。" />
    <Error Condition="'$(PreferredToolArchitecture)' != '$(EfmHostArchitecture)'"
           Text="主機工具需使用配方指定的 x64 版本。" />
    <Error Condition="'$(PlatformToolset)' != '$(EfmPlatformToolset)' Or '$(VCToolsVersion)' != '$(EfmVCToolsVersion)' Or '$(WindowsTargetPlatformVersion)' != '$(EfmWindowsSdkVersion)'"
           Text="工具鏈不符，請使用 src/efm/EfmBuild.props 的配方。" />
    <Error Condition="'$(CL)' != '' Or '$(_CL_)' != '' Or '$(LINK)' != '' Or '$(_LINK_)' != ''"
           Text="請清除 CL/_CL_/LINK/_LINK_ 環境變數後重建。" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(EfmRepoRoot)\tools\check_efm_toolchain.ps1&quot; -ToolchainRoot &quot;$(VCToolsInstallDir).&quot; -SdkRoot &quot;$(WindowsSdkDir).&quot; -MsBuildPath &quot;$(MSBuildBinPath)\MSBuild.exe&quot;" />
  </Target>
</Project>
