<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="ValidateEfmBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)|$(Platform)' != 'Release|x64'"
           Text="EFM supports only Release|x64." />
    <Error Condition="'$(PreferredToolArchitecture)' != '$(EfmHostArchitecture)'"
           Text="EFM must use the pinned x64 host compiler and linker." />
    <Error Condition="'$(PlatformToolset)' != '$(EfmPlatformToolset)' Or '$(VCToolsVersion)' != '$(EfmVCToolsVersion)' Or '$(WindowsTargetPlatformVersion)' != '$(EfmWindowsSdkVersion)'"
           Text="EFM toolchain differs from src/efm/EfmBuild.props. Use the pinned profile." />
    <Error Condition="'$(CL)' != '' Or '$(_CL_)' != '' Or '$(LINK)' != '' Or '$(_LINK_)' != ''"
           Text="CL/_CL_/LINK/_LINK_ environment overrides are not allowed in reproducible EFM builds." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(EfmRepoRoot)\tools\check_efm_toolchain.ps1&quot; -ToolchainRoot &quot;$(VCToolsInstallDir).&quot; -SdkRoot &quot;$(WindowsSdkDir).&quot;" />
  </Target>
</Project>
