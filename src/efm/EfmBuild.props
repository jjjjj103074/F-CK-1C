  <PropertyGroup Condition="'$(EfmVCTargetsRoot)' != ''">
    <VCTargetsPath>$(EfmVCTargetsRoot)\v180\</VCTargetsPath>
    <VCTargetsPath18>$(EfmVCTargetsRoot)\v180\</VCTargetsPath18>
    <VCTargetsPath17>$(EfmVCTargetsRoot)\v170\</VCTargetsPath17>
    <VCTargetsPath16>$(EfmVCTargetsRoot)\v160\</VCTargetsPath16>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/Brepro /experimental:deterministic /pathmap:"$(EfmRepoRoot)=$(EfmCanonicalSourceRoot)" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/Brepro /PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
