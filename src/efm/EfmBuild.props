<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- One profile for Visual Studio, command-line builds, and PR validation. -->
  <PropertyGroup>
    <EfmPlatformToolset>v142</EfmPlatformToolset>
    <EfmHostArchitecture>x64</EfmHostArchitecture>
    <EfmVCToolsVersion>14.29.30133</EfmVCToolsVersion>
    <EfmWindowsSdkVersion>10.0.26100.0</EfmWindowsSdkVersion>
    <EfmCompilerVersion>19.29.30159.0</EfmCompilerVersion>
    <EfmLinkerVersion>14.29.30159.0</EfmLinkerVersion>
    <EfmMsBuildVersion>18.10.1.42706</EfmMsBuildVersion>
    <EfmRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..').TrimEnd('\'))</EfmRepoRoot>
    <EfmCanonicalSourceRoot>D:\efm-repro</EfmCanonicalSourceRoot>
    <VCToolsVersion>$(EfmVCToolsVersion)</VCToolsVersion>
    <PreferredToolArchitecture>$(EfmHostArchitecture)</PreferredToolArchitecture>
    <WindowsTargetPlatformVersion>$(EfmWindowsSdkVersion)</WindowsTargetPlatformVersion>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnableASAN>false</EnableASAN>
    <CLRSupport>false</CLRSupport>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/Brepro /experimental:deterministic /pathmap:"$(EfmRepoRoot)=$(EfmCanonicalSourceRoot)" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/Brepro /PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
