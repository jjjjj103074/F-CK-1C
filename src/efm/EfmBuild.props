    <EfmCanonicalSourceRoot>D:\efm-repro</EfmCanonicalSourceRoot>
    <VCToolsVersion>$(EfmVCToolsVersion)</VCToolsVersion>
    <PreferredToolArchitecture>$(EfmHostArchitecture)</PreferredToolArchitecture>
    <WindowsTargetPlatformVersion>$(EfmWindowsSdkVersion)</WindowsTargetPlatformVersion>
