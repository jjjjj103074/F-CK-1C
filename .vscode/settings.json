{
    // ─── Conventional Commits Extension ───────────────────────────────────────
    // Keep this list in sync with commitlint.config.js → scope-enum
    "conventionalCommits.scopes": [
        "core",
        "efm",
        "cockpit",
        "assets",
        "tooling",
        "docs"
    ],
    // Keep commit titles plain; types are enforced by commitlint/czg.
    "conventionalCommits.gitmoji": false,
    // ──────────────────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.wordWrap": "off",
    "editor.renderWhitespace": "all",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": true,
    "editor.stickyScroll.enabled": true,
    "editor.minimap.enabled": true,
    "editor.lineNumbers": "relative",
    "files.eol": "\r\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    // Use the same pinned native formatter as the CLI and Visual Studio.
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "none",
    "C_Cpp.clang_format_path": "${workspaceFolder}/node_modules/@polycam/clang-tools-win32-x64/bin/clang-format.exe",
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[lua]": {
        "editor.defaultFormatter": "JohnnyMorganz.stylua",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "Lua.format.enable": false,
    "Lua.diagnostics.enable": false,
    "Lua.telemetry.enable": false
}
